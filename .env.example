# Notion integration token (create at https://www.notion.so/my-integrations,
# then share the "All Product Delivery Teams" database with it — View access is enough)
NOTION_TOKEN=secret_xxx

# Slack bot token (create at https://api.slack.com/apps, scopes:
# users:read + users:read.email, install to the Aiven workspace).
# Used only to fetch profile photos by email — nothing is posted or read.
SLACK_BOT_TOKEN=xoxb-xxx

# How often the Slack avatar cache refreshes, in milliseconds. Default: 7 days.
# Profile photos change rarely, so this stays far less frequent than the Notion sync.
SLACK_AVATAR_REFRESH_MS=604800000

# The data source id, not the database id.
# From the database URL / the "collection://<id>" reference — currently:
NOTION_DATA_SOURCE_ID=a814a013-b5ca-4dd9-a1aa-a43ed96b5f57

# How often the server re-syncs from Notion, in milliseconds. Default: 15 minutes.
SYNC_INTERVAL_MS=900000

# Port the app listens on. Aiven Runtime sets this automatically — override only if needed.
PORT=8080
